# Copia este archivo como ".env" (en la misma carpeta que manage.py) y completa los valores.
# El archivo .env NUNCA se sube al repositorio: ya está en el .gitignore.
# Si no creas .env, el proyecto arranca en modo desarrollo con SQLite.

# --- Django ---
# En desarrollo: True. En producción: False (y entonces DJANGO_SECRET_KEY es obligatoria).
DJANGO_DEBUG=True
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Dominios desde los que se accede al backend, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend ---
# Sitios que pueden llamar a la API desde el navegador (el de Vite en desarrollo).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Solo si el frontend se publica con HTTPS en otro dominio, ej: https://cajaclara.ejemplo.cl
CSRF_TRUSTED_ORIGINS=

# --- Login (JWT) ---
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_DIAS=7
# Intentos de login permitidos por persona (ej: 10/min, 5/min)
LOGIN_RATE=10/min

# --- Base de datos (opcional; sin DB_ENGINE se usa SQLite) ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cajaclara
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
